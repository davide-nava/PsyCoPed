# All values are optional. The site is static (GitHub Pages): without endpoints the forms
# fall back to mailto: links. PUBLIC_* values end up in the browser bundle - never put secrets here.
PUBLIC_SITE_URL=https://davide-nava.github.io
PUBLIC_BASE_PATH=/PsyCoPed/
# Formspree / Web3Forms / custom webhook (accepts JSON or FormData POST)
PUBLIC_CONTACT_ENDPOINT=
PUBLIC_BOOKING_ENDPOINT=
# JSON array of occupied slots: [{"professional":"provini","date":"2026-12-01","time":"10:00"}]
PUBLIC_AGENDA_FEED_URL=
