---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { discography, musicProjects, videos, artisticBioEn } from '../data/content';
const crumbs = [{ name: 'Vocal Coach & Carriera Artistica', href: '/vocal-coach' }];
const blocks = [
  { id: 'chi-sono', title: 'Chi sono', body: 'Accanto all’attività clinica, Mirko Provini svolge un percorso artistico e di vocal coach. Questa area, distinta dal percorso di psicoterapia e consulenza, raccoglie biografia, video, discografia e progetti musicali.' },
];
---

<BaseLayout title="Vocal Coach e Carriera Artistica" description="Vocal coach e carriera artistica di Mirko Provini: biografia (ENG), video, discografia e progetti musicali." crumbs={crumbs}>
  <PageHeader eyebrow="Area artistica — separata dall’attività clinica" title="Vocal Coach & Carriera Artistica" crumbs={crumbs} />
  <section class="section">
    <div class="container-page max-w-4xl space-y-12">
      <nav aria-label="Sezioni dell’area artistica"><ul class="flex flex-wrap gap-3">
        {[['chi-sono', 'Chi sono'], ['bio', 'Biography (ENG)'], ['video', 'Video'], ['discografia', 'Discografia'], ['progetti', 'Progetti musicali']].map(([id, l]) => <li><a class="btn btn-secondary !min-h-11 !py-1" href={`#${id}`}>{l}</a></li>)}
      </ul></nav>

      {blocks.map((b) => <section id={b.id} class="prose-clinic"><h2>{b.title}</h2><p>{b.body}</p></section>)}

      <section id="bio" class="prose-clinic" lang="en"><h2>Artistic Biography</h2><p>{artisticBioEn}</p></section>

      <section id="video"><h2>Video</h2>
        {videos.length ? (
          <ul class="mt-4 grid gap-6 sm:grid-cols-2">
            {videos.map((v) => <li><a href={`https://www.youtube.com/watch?v=${v.youtubeId}`} rel="noopener noreferrer" target="_blank">{v.title}<span class="sr-only"> (YouTube, nuova scheda)</span></a></li>)}
          </ul>
        ) : <p class="mt-3">I video verranno aggiunti a breve.</p>}
      </section>

      <section id="discografia"><h2>Discografia</h2>
        {discography.length ? <ul class="mt-4 space-y-3">{discography.map((d) => <li class="card">{d.title}{d.year && ` (${d.year})`}</li>)}</ul> : <p class="mt-3">Discografia in aggiornamento.</p>}
      </section>

      <section id="progetti"><h2>Progetti musicali</h2>
        {musicProjects.length ? <ul class="mt-4 space-y-3">{musicProjects.map((d) => <li class="card">{d.title}</li>)}</ul> : <p class="mt-3">Progetti in aggiornamento.</p>}
      </section>
    </div>
  </section>
</BaseLayout>
