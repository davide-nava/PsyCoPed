---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { publications } from '../data/content';
const crumbs = [{ name: 'Pubblicazioni & Progetti', href: '/pubblicazioni' }];
---

<BaseLayout title="Pubblicazioni & Progetti" description="Pubblicazioni, collaborazioni editoriali con TXT-RSI e progetti del Dott. Mirko Provini, psicologo clinico e neuropsicologo." crumbs={crumbs}>
  <PageHeader title="Pubblicazioni & Progetti" lead="Contributi editoriali, collaborazioni e progetti dello studio." crumbs={crumbs} />
  <section class="section">
    <div class="container-page max-w-4xl">
      <ul class="space-y-5">
        {publications.map((p) => (
          <li class="card"><h2 class="!text-xl">{p.title}</h2>{p.description && <p class="mt-2">{p.description}</p>}{p.url && <p class="mt-2"><a href={p.url} rel="noopener noreferrer" target="_blank">Leggi</a></p>}</li>
        ))}
      </ul>
      <p class="mt-8 text-slate-600">Altre pubblicazioni e progetti verranno aggiunti qui. Vedi anche le <a href="/interviste">interviste</a>.</p>
    </div>
  </section>
</BaseLayout>
