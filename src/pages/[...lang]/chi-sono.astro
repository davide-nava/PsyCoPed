---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getProfessionals } from '../../config/site';
import { personSchema } from '../../lib/schema';
import { i18n, getLocaleStaticPaths } from '../../i18n';

export const getStaticPaths = getLocaleStaticPaths;

const { locale, t, l } = i18n(Astro);
const a = t.about;
const professionals = getProfessionals(locale);
const crumbs = [{ name: a.crumb, href: l('/chi-sono') }];
---

<BaseLayout
  title={a.title}
  description={a.description}
  pageType="AboutPage"
  crumbs={crumbs}
  schemas={[{ '@context': 'https://schema.org', ...personSchema('provini', locale) }, { '@context': 'https://schema.org', ...personSchema('coccia', locale) }]}>
  <PageHeader title={a.headerTitle} lead={a.lead} crumbs={crumbs} />

  <section class="section">
    <div class="container-page grid gap-8 lg:grid-cols-2">
      {Object.values(professionals).map((p) => (
        <article id={p.id} class="card" aria-labelledby={`${p.id}-name`}>
          <h2 id={`${p.id}-name`} class="!text-3xl">{p.name}</h2>
          <p class="mt-1 font-semibold text-teal-700">{p.title}</p>
          {p.registration && <p class="text-sm text-slate-600">{p.registration}</p>}
          <div class="mt-5 space-y-4">{p.bio.map((para) => <p>{para}</p>)}</div>
          <h3 class="mt-6 !text-lg">{a.areas}</h3>
          <ul class="mt-2 flex flex-wrap gap-2">{p.specializations.map((s) => <li class="rounded-full bg-sage-100 px-3 py-1 text-sm font-medium">{s}</li>)}</ul>
          <p class="mt-6">{a.phoneLabel} <a href={`tel:${p.phoneRaw}`}>{p.phone}</a></p>
          <a class="btn btn-primary mt-4" href={l(`/prenota?professional=${p.id}`)}>{a.bookWith} {p.shortName}</a>
        </article>
      ))}
    </div>
  </section>

  <section class="section bg-white">
    <div class="container-page prose-clinic">
      <h2>{a.approachTitle}</h2>
      <p>{a.approach1}</p>
      <p>{a.approach2}</p>
      <h2>{a.ethicsTitle}</h2>
      <ul>
        {a.ethics.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
