---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import FaqList from '../../components/FaqList.astro';
import EmergencyNotice from '../../components/EmergencyNotice.astro';
import { getFaqs } from '../../data/faq';
import { faqSchema } from '../../lib/schema';
import { i18n, getLocaleStaticPaths } from '../../i18n';

export const getStaticPaths = getLocaleStaticPaths;

const { locale, t, l } = i18n(Astro);
const h = t.how;
const faqs = getFaqs(locale);
const crumbs = [{ name: h.crumb, href: l('/come-funziona') }];
---

<BaseLayout title={h.title} description={h.description} crumbs={crumbs} schemas={[faqSchema(faqs)]}>
  <PageHeader title={h.headerTitle} lead={h.lead} crumbs={crumbs} />
  <section class="section">
    <div class="container-page">
      <ol class="grid gap-6 md:grid-cols-4">
        {h.steps.map(([title, desc], i) => (
          <li class="card"><span class="font-serif text-3xl text-teal-600">{i + 1}</span><h2 class="!text-xl">{title}</h2><p class="mt-2 text-slate-700">{desc}</p></li>
        ))}
      </ol>
      <div class="mt-12"><EmergencyNotice /></div>
      <h2 class="mb-6 mt-14">{h.faqTitle}</h2>
      <FaqList items={faqs} />
      <div class="mt-10 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={l('/prenota')}>{t.common.bookSession}</a>
        <a class="btn btn-secondary" href={l('/contatti')}>{t.common.requestInfo}</a>
      </div>
    </div>
  </section>
</BaseLayout>
