---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { discography, musicProjects, videos } from '../../data/content';
import { i18n, getLocaleStaticPaths } from '../../i18n';

export const getStaticPaths = getLocaleStaticPaths;

const { t, l } = i18n(Astro);
const v = t.vocal;
const crumbs = [{ name: v.crumb, href: l('/vocal-coach') }];
---

<BaseLayout title={v.title} description={v.description} crumbs={crumbs}>
  <PageHeader eyebrow={v.eyebrow} title={v.headerTitle} crumbs={crumbs} />
  <section class="section">
    <div class="container-page max-w-4xl space-y-12">
      <nav aria-label={v.sectionsNav}><ul class="flex flex-wrap gap-3">
        {v.nav.map(([id, label]) => <li><a class="btn btn-secondary !min-h-11 !py-1" href={`#${id}`}>{label}</a></li>)}
      </ul></nav>

      <section id="chi-sono" class="prose-clinic"><h2>{v.aboutTitle}</h2><p>{v.aboutBody}</p></section>

      <section id="bio" class="prose-clinic" lang={v.bioIsEnglish ? 'en' : undefined}><h2>{v.bioTitle}</h2><p>{v.bioBody}</p></section>

      <section id="video"><h2>{v.videoTitle}</h2>
        {videos.length ? (
          <ul class="mt-4 grid gap-6 sm:grid-cols-2">
            {videos.map((vid) => <li><a href={`https://www.youtube.com/watch?v=${vid.youtubeId}`} rel="noopener noreferrer" target="_blank">{vid.title}<span class="sr-only">{v.videoSr}</span></a></li>)}
          </ul>
        ) : <p class="mt-3">{v.videoEmpty}</p>}
      </section>

      <section id="discografia"><h2>{v.discographyTitle}</h2>
        {discography.length ? <ul class="mt-4 space-y-3">{discography.map((d) => <li class="card">{d.title}{d.year && ` (${d.year})`}</li>)}</ul> : <p class="mt-3">{v.discographyEmpty}</p>}
      </section>

      <section id="progetti"><h2>{v.projectsTitle}</h2>
        {musicProjects.length ? <ul class="mt-4 space-y-3">{musicProjects.map((d) => <li class="card">{d.title}</li>)}</ul> : <p class="mt-3">{v.projectsEmpty}</p>}
      </section>
    </div>
  </section>
</BaseLayout>
