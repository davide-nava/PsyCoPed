---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { getPublications } from '../../data/content';
import { i18n, getLocaleStaticPaths } from '../../i18n';

export const getStaticPaths = getLocaleStaticPaths;

const { locale, t, l } = i18n(Astro);
const p = t.publications;
const publications = getPublications(locale);
const crumbs = [{ name: p.crumb, href: l('/pubblicazioni') }];
---

<BaseLayout title={p.title} description={p.description} crumbs={crumbs}>
  <PageHeader title={p.title} lead={p.lead} crumbs={crumbs} />
  <section class="section">
    <div class="container-page max-w-4xl">
      <ul class="space-y-5">
        {publications.map((item) => (
          <li class="card"><h2 class="!text-xl">{item.title}</h2>{item.description && <p class="mt-2">{item.description}</p>}{item.url && <p class="mt-2"><a href={item.url} rel="noopener noreferrer" target="_blank">{t.common.readLabel}</a></p>}</li>
        ))}
      </ul>
      <p class="mt-8 text-slate-600">{p.more} <a href={l('/interviste')}>{p.interviewsLink}</a>.</p>
    </div>
  </section>
</BaseLayout>
