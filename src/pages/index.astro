---
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FaqList from '../components/FaqList.astro';
import ContactBlock from '../components/ContactBlock.astro';
import EmergencyNotice from '../components/EmergencyNotice.astro';
import { services } from '../data/services';
import { faqs } from '../data/faq';
import { faqSchema } from '../lib/schema';

const preview = faqs.slice(0, 4);
const trust = [
  ['Psicologo iscritto all’Albo', 'Dott. Mirko Provini, OPL n. 24451'],
  ['In studio e online', 'Cremenaga (VA) o videoconsulenza'],
  ['Riservatezza', 'Segreto professionale e tutela dei dati'],
  ['Équipe multidisciplinare', 'Psicologia, neuropsicologia, pedagogia'],
];
---

<BaseLayout
  title="Psicologo a Cremenaga (VA) e online | Studio PsyCoPed"
  rawTitle
  description="Studio di psicologia a Cremenaga (Varese): consulenza psicologica, neuropsicologia, pedagogia e DSA, ipnosi e coaching. In studio e online."
  schemas={[faqSchema(preview)]}>

  <section class="bg-gradient-to-b from-sage-100 to-surface">
    <div class="container-page grid items-center gap-10 py-16 md:grid-cols-[1.3fr_1fr] md:py-24">
      <div>
        <p class="eyebrow">Studio PsyCoPed vi dà il benvenuto</p>
        <h1>Il vostro benessere psicofisico è in buone mani</h1>
        <p class="mt-5 max-w-2xl text-lg text-slate-700">
          Un trauma, la perdita di una persona cara, attacchi di panico, ansia da prestazione al lavoro o a scuola,
          un grande cambiamento di vita: non dovete affrontarli da soli. Lo studio vi accompagna con ascolto, competenza e rispetto.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn btn-primary" href="/prenota">Prenota una seduta</a>
          <a class="btn btn-secondary" href="/contatti">Richiedi informazioni</a>
        </div>
      </div>
      <figure class="card bg-white">
        <blockquote class="font-serif text-2xl leading-snug text-navy-900">
          “Essere uomini e donne significa avvertire un sentimento di inferiorità che esige di essere superato.”
        </blockquote>
        <figcaption class="mt-4 font-semibold text-teal-700">— Alfred Adler</figcaption>
      </figure>
    </div>
  </section>

  <section aria-label="Garanzie e credenziali" class="border-y border-line bg-white">
    <ul class="container-page grid gap-6 py-8 sm:grid-cols-2 lg:grid-cols-4">
      {trust.map(([t, d]) => (
        <li><p class="font-semibold text-navy-900">{t}</p><p class="text-sm text-slate-600">{d}</p></li>
      ))}
    </ul>
  </section>

  <section class="section">
    <div class="container-page grid gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow">Una guida sicura verso il tuo benessere psicofisico</p>
        <h2>Cosa bisogna sapere sulla terapia</h2>
      </div>
      <div class="prose-clinic">
        <p>La terapia non è una pillola magica né una soluzione istantanea. È un processo di cura che richiede <strong>tempo</strong> e la <strong>partecipazione attiva</strong> di entrambi: del paziente e del terapeuta.</p>
        <p>Piccoli cambiamenti nei comportamenti autodistruttivi e il superamento del senso di inferiorità — tristezza, paura, dolore — possono portare a risultati che cambiano la vita.</p>
        <p><a href="/come-funziona">Scopri come funziona un percorso →</a></p>
      </div>
    </div>
  </section>

  <section class="section bg-white" aria-labelledby="local-title">
    <div class="container-page prose-clinic">
      <h2 id="local-title">Psicologo a Cremenaga, in provincia di Varese, e online</h2>
      <p>Lo Studio PsyCoPed si trova in Via Provinciale 43 a Cremenaga (VA) e offre <a href="/servizi/consulenza-psicologica">consulenza psicologica</a>, <a href="/servizi/neuropsicologia">valutazione neuropsicologica</a>, <a href="/servizi/consulenza-pedagogica">consulenza pedagogica e DSA</a>, <a href="/servizi/ipnosi">ipnosi</a> e <a href="/servizi/professional-coaching">professional coaching</a>.</p>
      <p>Gli incontri si svolgono in studio oppure in videoconsulenza, con il Dott. Mirko Provini e la Dott.ssa Valentina Coccia. <a href="/chi-sono">Conosci l’équipe</a>.</p>
    </div>
  </section>

  <section class="section bg-sage-100" aria-labelledby="services-title">
    <div class="container-page">
      <p class="eyebrow">Servizi di sostegno psicologico</p>
      <h2 id="services-title">Al vostro fianco ad ogni passo</h2>
      <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => <ServiceCard service={s} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container-page">
      <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
        <div><p class="eyebrow">Domande frequenti</p><h2>Prima di iniziare</h2></div>
        <a href="/come-funziona">Tutte le FAQ →</a>
      </div>
      <FaqList items={preview} />
      <div class="mt-8"><EmergencyNotice /></div>
    </div>
  </section>

  <ContactBlock />
</BaseLayout>
