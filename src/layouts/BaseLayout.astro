---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site } from '../config/site';
import { i18n, locales, localePath, stripLocale, bcp47, ogLocale, type Locale } from '../i18n';
import { practiceSchema, websiteSchema, webPageSchema, breadcrumbSchema } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  crumbs?: { name: string; href: string }[];
  schemas?: object[];
  noindex?: boolean;
  /** schema.org WebPage subtype, e.g. AboutPage, ContactPage, CollectionPage */
  pageType?: string;
  /** Use the title as-is (no brand suffix), e.g. for the home page */
  rawTitle?: boolean;
}

const { title, description, crumbs = [], schemas = [], noindex = false, pageType = 'WebPage', rawTitle = false } = Astro.props;
const { locale, t } = i18n(Astro);
const fullPath = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
/** Path without the locale prefix: identical across languages. */
const path = stripLocale(fullPath);
const abs = (loc: Locale) => new URL(localePath(loc, path) === '/' ? '' : localePath(loc, path), site.url).href;
const canonical = abs(locale);
const otherLocales = locales.filter((l) => l !== locale);
const suffix = ` | ${site.name}`;
// Keep <title> within ~60 chars: append the brand only when it fits.
const fullTitle = rawTitle || title.length + suffix.length > 62 || title.includes(site.name) ? title : title + suffix;
const image = new URL('/og-image.png', site.url).href;
const isHome = path === '/';
const jsonLd = [
  practiceSchema(locale),
  ...(isHome ? [websiteSchema(locale)] : []),
  webPageSchema({ type: pageType, url: canonical, name: fullTitle, description, locale }),
  ...(crumbs.length ? [breadcrumbSchema([{ name: t.common.home, href: localePath(locale, '/') }, ...crumbs])] : []),
  ...schemas,
];
---

<!doctype html>
<html lang={t.meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {locales.map((l) => <link rel="alternate" hreflang={bcp47[l]} href={abs(l)} />)}
    <link rel="alternate" hreflang="x-default" href={abs('it')} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#1e3a4c" />
    <meta name="author" content="Studio PsyCoPed" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    <meta name="geo.region" content="IT-VA" />
    <meta name="geo.placename" content="Cremenaga" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={ogLocale[locale]} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    {jsonLd.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="skip-link">{t.common.skipToContent}</a>
    <Header currentPath={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <CookieBanner />
  </body>
</html>
