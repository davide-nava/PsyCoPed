---
import { nav } from '../config/site';
import { i18n, locales, bcp47 } from '../i18n';
import { isActivePath, switchLocalePath } from '../utils/url';
const { locale, t, l } = i18n(Astro);
const isActive = (href: string) => isActivePath(Astro.url.pathname, l(href));
const other = locales.find((x) => x !== locale)!;
const switchHref = switchLocalePath(Astro.url.pathname, other);
---

<header class="sticky top-0 z-40 border-b border-line bg-white/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href={l('/')} class="flex items-center gap-3 no-underline" aria-label={t.header.homeAria}>
      <span class="grid h-10 w-10 place-items-center rounded-xl bg-navy-800 font-serif text-xl text-sage-100" aria-hidden="true">Ψ</span>
      <span class="font-serif text-xl font-semibold text-navy-900">PsyCoPed</span>
    </a>

    <nav aria-label={t.header.mainNav} class="hidden lg:block">
      <ul class="flex items-center gap-1">
        {nav.map((item) => (
          <li>
            <a
              href={l(item.href)}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class:list={[
                'rounded-full px-3 py-2 text-[0.95rem] font-medium no-underline',
                isActive(item.href) ? 'bg-sage-100 text-navy-900' : 'text-slate-700 hover:bg-sage-100',
              ]}>{t.nav[item.key]}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        data-lang-switch
        hreflang={other}
        lang={bcp47[other]}
        aria-label={t.header.switchTo}
        title={t.header.switchTo}
        class="inline-flex min-h-11 items-center gap-1.5 rounded-xl border border-line px-3 text-sm font-semibold text-navy-900 no-underline hover:bg-sage-100">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" /></svg>
        <span aria-hidden="true">{t.header.otherLocaleCode}</span>
      </a>
      <a href={l('/prenota')} class="btn btn-primary hidden !min-h-11 !px-5 !py-2 sm:inline-flex">{t.common.book}</a>
      <button
        id="menu-toggle"
        type="button"
        class="grid h-11 w-11 place-items-center rounded-xl border border-line lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-label-open={t.header.openMenu}
        data-label-close={t.header.closeMenu}
        aria-label={t.header.openMenu}>
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label={t.header.mobileNav} class="hidden border-t border-line bg-white lg:hidden">
    <ul class="container-page flex flex-col py-3">
      {nav.map((item) => (
        <li>
          <a href={l(item.href)} aria-current={isActive(item.href) ? 'page' : undefined} class="block rounded-lg px-3 py-3 font-medium no-underline hover:bg-sage-100">{t.nav[item.key]}</a>
        </li>
      ))}
      <li class="pt-2"><a href={l('/prenota')} class="btn btn-primary w-full">{t.common.bookSession}</a></li>
    </ul>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', (open ? btn.dataset.labelOpen : btn.dataset.labelClose) ?? '');
    menu?.classList.toggle('hidden', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      btn.click();
      btn.focus();
    }
  });
  // Keep the query string and hash (e.g. ?servizio=ipnosi) when switching language.
  document.querySelectorAll<HTMLAnchorElement>('[data-lang-switch]').forEach((a) => {
    a.href += location.search + location.hash;
  });
</script>
