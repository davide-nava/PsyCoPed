---
interface Props { title: string; lead?: string; crumbs?: { name: string; href: string }[]; eyebrow?: string }
const { title, lead, crumbs = [], eyebrow } = Astro.props;
---

<section class="bg-sage-100">
  <div class="container-page py-12 md:py-16">
    {crumbs.length > 0 && (
      <nav aria-label="Breadcrumb" class="mb-5 text-sm">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/">Home</a></li>
          {crumbs.map((c, i) => (
            <li class="flex items-center gap-2">
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </li>
          ))}
        </ol>
      </nav>
    )}
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    {lead && <p class="mt-4 max-w-3xl text-lg text-slate-700">{lead}</p>}
  </div>
</section>
