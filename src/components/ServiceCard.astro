---
import Icon from './Icon.astro';
import type { Service } from '../data/services';
interface Props { service: Service }
const { service } = Astro.props;
---

<article class="card flex h-full flex-col transition hover:-translate-y-0.5 hover:shadow-md">
  <span class="mb-4 grid h-12 w-12 place-items-center rounded-xl bg-sage-100 text-teal-700"><Icon name={service.icon} /></span>
  <h3 class="!text-xl">{service.title}</h3>
  <p class="mt-2 flex-1 text-slate-700">{service.summary}</p>
  <a href={`/servizi/${service.slug}`} class="mt-4 inline-flex min-h-11 items-center font-semibold">
    Scopri di più<span class="sr-only">: {service.title}</span> <span aria-hidden="true">&nbsp;→</span>
  </a>
</article>
