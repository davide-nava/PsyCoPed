---
import { site, getProfessionals } from '../config/site';
import { bookingServices } from '../data/agenda';
import { i18n, bcp47 } from '../i18n';

interface Props { presetService?: string }
const { presetService = '' } = Astro.props;
const { locale, t, l } = i18n(Astro);
const b = t.booking;
const professionals = getProfessionals(locale);
const services = bookingServices.map((s) => ({ id: s.id as string, minutes: s.minutes as number, label: s.label[locale] }));

// Strings and settings needed by the client-side script (the agenda itself is bundled with the script).
const clientT = { locale, dateLocale: bcp47[locale], booking: b, validation: t.validation };
---

<div id="booking" class="card !p-0 overflow-hidden"
  data-services={JSON.stringify(services)}
  data-professionals={JSON.stringify({ provini: professionals.provini.name, coccia: professionals.coccia.name })}
  data-preset={presetService} data-t={JSON.stringify(clientT)}>

  <div class="border-b border-amber-300 bg-amber-50 px-6 py-3 text-sm text-amber-950" role="note">
    <strong>{b.sampleStrong}</strong> {b.sampleText}
  </div>

  <ol class="flex flex-wrap gap-2 border-b border-line bg-sage-100 px-6 py-4 text-sm" aria-label={b.progress} id="booking-progress">
    {b.steps.map((s, i) => (
      <li data-step-indicator={i + 1} class="flex items-center gap-2 rounded-full px-3 py-1 font-medium">
        <span class="grid h-6 w-6 place-items-center rounded-full bg-white text-xs">{i + 1}</span>{s}
      </li>
    ))}
  </ol>

  <form id="booking-form" novalidate class="p-6 md:p-8">
    <div id="booking-error" role="alert" tabindex="-1" hidden class="mb-5 rounded-xl border-2 border-alert bg-alert-bg p-4 font-medium text-alert"></div>

    <section data-step="1" aria-labelledby="bk-h1">
      <h2 id="bk-h1" class="!text-2xl" tabindex="-1">{b.h1}</h2>
      <fieldset class="mt-5 grid gap-3">
        <legend class="sr-only">{b.legendService}</legend>
        {services.map((s) => (
          <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border border-line p-4 has-[:checked]:border-teal-600 has-[:checked]:bg-sage-100">
            <input type="radio" name="service" value={s.id} class="h-5 w-5" checked={s.id === presetService} />
            <span>{s.label} <span class="text-sm text-slate-600">· {b.about} {s.minutes} {b.min}</span></span>
          </label>
        ))}
      </fieldset>
    </section>

    <section data-step="2" aria-labelledby="bk-h2" hidden>
      <h2 id="bk-h2" class="!text-2xl" tabindex="-1">{b.h2}</h2>
      <fieldset class="mt-5 grid gap-3 sm:grid-cols-2">
        <legend class="sr-only">{b.legendFormat}</legend>
        <label class="flex min-h-14 cursor-pointer items-start gap-3 rounded-xl border border-line p-4 has-[:checked]:border-teal-600 has-[:checked]:bg-sage-100">
          <input type="radio" name="format" value="studio" class="mt-1 h-5 w-5" />
          <span><strong>{b.inStudio}</strong><br /><span class="text-sm text-slate-600">{site.address.street}, {site.address.city} ({site.address.province})</span></span>
        </label>
        <label class="flex min-h-14 cursor-pointer items-start gap-3 rounded-xl border border-line p-4 has-[:checked]:border-teal-600 has-[:checked]:bg-sage-100">
          <input type="radio" name="format" value="online" class="mt-1 h-5 w-5" />
          <span><strong>{b.online}</strong><br /><span class="text-sm text-slate-600">{b.onlineHint}</span></span>
        </label>
      </fieldset>
    </section>

    <section data-step="3" aria-labelledby="bk-h3" hidden>
      <h2 id="bk-h3" class="!text-2xl" tabindex="-1">{b.h3}</h2>
      <fieldset class="mt-5 grid gap-3">
        <legend class="sr-only">{b.legendPro}</legend>
        <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border border-line p-4 has-[:checked]:border-teal-600 has-[:checked]:bg-sage-100">
          <input type="radio" name="professional" value="any" class="h-5 w-5" checked />
          <span><strong>{b.firstAvailable}</strong></span>
        </label>
        {Object.values(professionals).map((p) => (
          <label class="flex min-h-14 cursor-pointer items-center gap-3 rounded-xl border border-line p-4 has-[:checked]:border-teal-600 has-[:checked]:bg-sage-100">
            <input type="radio" name="professional" value={p.id} class="h-5 w-5" />
            <span><strong>{p.name}</strong><br /><span class="text-sm text-slate-600">{p.title}</span></span>
          </label>
        ))}
      </fieldset>
    </section>

    <section data-step="4" aria-labelledby="bk-h4" hidden>
      <h2 id="bk-h4" class="!text-2xl" tabindex="-1">{b.h4}</h2>
      <div class="mt-5 grid gap-8 md:grid-cols-[minmax(0,22rem)_1fr]">
        <div>
          <div class="mb-3 flex items-center justify-between">
            <button type="button" id="cal-prev" class="btn btn-secondary !min-h-11 !px-4 !py-1" aria-label={b.prevMonth}>←</button>
            <p id="cal-title" class="font-serif text-lg font-semibold" aria-live="polite"></p>
            <button type="button" id="cal-next" class="btn btn-secondary !min-h-11 !px-4 !py-1" aria-label={b.nextMonth}>→</button>
          </div>
          <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold uppercase text-slate-600" aria-hidden="true">
            {b.weekdays.map((d) => <span>{d}</span>)}
          </div>
          <div id="cal-grid" class="mt-1 grid grid-cols-7 gap-1" role="group" aria-labelledby="cal-title"></div>
          <p class="hint">{b.availableHint}</p>
        </div>
        <div>
          <p id="slots-title" class="font-semibold">{b.pickDayFirst}</p>
          <div id="slots" class="mt-3 flex flex-wrap gap-2" role="radiogroup" aria-labelledby="slots-title"></div>
        </div>
      </div>
    </section>

    <section data-step="5" aria-labelledby="bk-h5" hidden>
      <h2 id="bk-h5" class="!text-2xl" tabindex="-1">{b.h5}</h2>
      <p id="bk-summary" class="mt-3 rounded-xl bg-sage-100 p-4 font-medium"></p>
      <p class="mt-4 rounded-xl border-2 border-amber-400 bg-amber-50 p-4 text-amber-950" role="note"><strong>{b.sensitiveWarning}</strong></p>
      <p class="mt-3 rounded-xl border border-alert bg-alert-bg p-4 text-ink" role="note"><strong class="text-alert">{b.emergencyTitle}.</strong> {b.emergencyText} <a class="font-semibold text-alert" href="tel:112">{t.common.callEmergency}</a>.</p>
      <div class="mt-5 grid gap-5 sm:grid-cols-2">
        <div class="field"><label for="b-name">{b.name}</label><input id="b-name" name="name" class="input" autocomplete="name" required /><p id="b-name-err" class="field-error" hidden></p></div>
        <div class="field"><label for="b-email">{b.email}</label><input id="b-email" name="email" type="email" class="input" autocomplete="email" required /><p id="b-email-err" class="field-error" hidden></p></div>
        <div class="field sm:col-span-2"><label for="b-phone">{b.phone}</label><input id="b-phone" name="phone" type="tel" class="input" autocomplete="tel" required /><p id="b-phone-err" class="field-error" hidden></p></div>
      </div>
      <div class="field mt-5">
        <label for="b-note">{b.note}</label>
        <textarea id="b-note" name="note" rows="3" maxlength="600" class="input" aria-describedby="b-note-hint"></textarea>
        <p id="b-note-hint" class="hint">{b.noteHint}</p>
        <p id="b-note-err" class="field-error" hidden></p>
      </div>
      <div aria-hidden="true" style="position:absolute;left:-9999px"><label>{b.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></div>
      <div class="mt-5 space-y-3">
        <label class="flex items-start gap-3"><input type="checkbox" name="policy" class="mt-1.5 h-5 w-5" />
          <span>{b.policyText}</span></label>
        <p id="b-policy-err" class="field-error" hidden></p>
        <label class="flex items-start gap-3"><input type="checkbox" name="consent" class="mt-1.5 h-5 w-5" />
          <span>{b.consentBefore}<a href={l('/privacy')} target="_blank">{b.consentLink}</a> {b.consentAfter}</span></label>
        <p id="b-consent-err" class="field-error" hidden></p>
      </div>
    </section>

    <div class="mt-8 flex flex-wrap justify-between gap-3" id="booking-nav">
      <button type="button" id="bk-back" class="btn btn-secondary" hidden>{b.back}</button>
      <button type="button" id="bk-next" class="btn btn-primary ml-auto">{b.next}</button>
      <button type="submit" id="bk-submit" class="btn btn-primary ml-auto" hidden>{b.submit}</button>
    </div>
  </form>

  <div id="booking-done" role="status" tabindex="-1" hidden class="p-6 md:p-8">
    <h2 class="!text-2xl">{b.doneTitle}</h2>
    <div id="done-body" class="mt-4 space-y-3"></div>
    <p class="mt-4 text-sm text-slate-600">{b.doneNote}</p>
    <button type="button" class="btn btn-secondary mt-5" id="bk-restart">{b.restart}</button>
  </div>
</div>

<script>
  import { validateBooking, type BookingPayload } from '../lib/validation';
  import { submitToEndpoint, mailtoHref } from '../lib/submit';
  import { site } from '../config/site';
  import { downloadBookingIcs } from '../utils/ics';
  import {
    fetchAgendaFeed,
    getAvailableSlotsForDate,
    agendaConfig,
    sessionLocations,
    toISODate,
    type OccupiedSlot,
    type SessionFormat,
    type Slot,
  } from '../data/agenda';
  import type { Dict } from '../i18n/it';

  const root = document.getElementById('booking') as HTMLElement;
  const form = document.getElementById('booking-form') as HTMLFormElement;
  const services: { id: string; label: string; minutes: number }[] = JSON.parse(root.dataset.services!);
  const names: Record<string, string> = JSON.parse(root.dataset.professionals!);
  const T: { locale: 'it' | 'en'; dateLocale: string; booking: Dict['booking']; validation: Dict['validation'] } = JSON.parse(root.dataset.t!);
  const B = T.booking;
  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const state = { step: 1, month: new Date(), date: '', time: '', resolvedPro: '' };
  state.month.setDate(1);
  const TOTAL = 5;
  /** Occupied slots merged at runtime from PUBLIC_AGENDA_FEED_URL (empty without a feed). */
  let feed: OccupiedSlot[] = [];
  const pad = (n: number) => String(n).padStart(2, '0');
  const iso = (y: number, m: number, d: number) => `${y}-${pad(m + 1)}-${pad(d)}`;
  const val = (name: string) => (form.elements.namedItem(name) as RadioNodeList | HTMLInputElement)?.value ?? '';
  const fmtDate = (s: string) => new Date(s + 'T12:00:00').toLocaleDateString(T.dateLocale, { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
  const selectedService = () => services.find((s) => s.id === val('service'));

  /** Free slots for a date given service, format and professional (or the union for "any"). */
  function slotsFor(date: string): Slot[] {
    return getAvailableSlotsForDate(date, {
      professional: (val('professional') || 'any') as 'any' | 'provini' | 'coccia',
      format: (val('format') || undefined) as SessionFormat | undefined,
      minutes: selectedService()?.minutes,
      extraOccupied: feed,
    });
  }
  const hasSlots = (date: string) => slotsFor(date).length > 0;

  function firstAvailableDate(): string {
    const start = new Date();
    for (let i = 0; i <= agendaConfig.horizonDays; i++) {
      const d = toISODate(new Date(start.getFullYear(), start.getMonth(), start.getDate() + i));
      if (hasSlots(d)) return d;
    }
    return '';
  }

  function renderCalendar() {
    const y = state.month.getFullYear(), m = state.month.getMonth();
    $('cal-title').textContent = state.month.toLocaleDateString(T.dateLocale, { month: 'long', year: 'numeric' });
    const first = (new Date(y, m, 1).getDay() + 6) % 7; // Monday first
    const days = new Date(y, m + 1, 0).getDate();
    const grid = $('cal-grid');
    grid.innerHTML = '';
    for (let i = 0; i < first; i++) grid.append(document.createElement('span'));
    for (let d = 1; d <= days; d++) {
      const date = iso(y, m, d);
      const b = document.createElement('button');
      b.type = 'button';
      b.textContent = String(d);
      const ok = hasSlots(date);
      b.disabled = !ok;
      b.setAttribute('aria-label', `${fmtDate(date)}${ok ? '' : B.unavailable}`);
      b.setAttribute('aria-pressed', String(state.date === date));
      b.className = 'min-h-11 rounded-lg text-base font-medium ' + (state.date === date ? 'bg-navy-800 text-white' : ok ? 'bg-sage-100 hover:bg-sage-200' : 'text-slate-400');
      b.addEventListener('click', () => { state.date = date; state.time = ''; renderCalendar(); renderSlots(); });
      grid.append(b);
    }
    ($('cal-prev') as HTMLButtonElement).disabled = state.month <= new Date(new Date().getFullYear(), new Date().getMonth(), 1);
  }

  function renderSlots() {
    const box = $('slots');
    box.innerHTML = '';
    if (!state.date) { $('slots-title').textContent = B.pickDayFirst; return; }
    $('slots-title').textContent = `${B.slotsFor} ${fmtDate(state.date)}`;
    const slots = slotsFor(state.date);
    if (!slots.length) { box.textContent = B.noSlots; return; }
    for (const s of slots) {
      const b = document.createElement('button');
      b.type = 'button';
      b.setAttribute('role', 'radio');
      b.setAttribute('aria-checked', String(state.time === s.time));
      b.textContent = s.time;
      b.className = 'min-h-11 min-w-20 rounded-full border-2 px-4 font-semibold ' + (state.time === s.time ? 'border-navy-800 bg-navy-800 text-white' : 'border-teal-600 text-teal-700 hover:bg-sage-100');
      b.addEventListener('click', () => { state.time = s.time; state.resolvedPro = s.professional; renderSlots(); });
      box.append(b);
    }
  }

  const resolvedPro = () => (val('professional') === 'any' ? state.resolvedPro : val('professional'));
  const formatLabel = () => (val('format') === 'online' ? B.online : B.summaryStudio);

  function summaryText() {
    return `${selectedService()?.label} · ${formatLabel()} · ${names[resolvedPro()]} · ${fmtDate(state.date)} ${B.summaryAt} ${state.time}`;
  }

  function showError(msg: string) {
    const el = $('booking-error');
    el.textContent = msg; el.hidden = !msg;
    if (msg) el.focus();
  }

  function go(step: number, focus = true) {
    state.step = step;
    form.querySelectorAll<HTMLElement>('[data-step]').forEach((s) => (s.hidden = Number(s.dataset.step) !== step));
    document.querySelectorAll<HTMLElement>('[data-step-indicator]').forEach((li) => {
      const n = Number(li.dataset.stepIndicator);
      li.className = 'flex items-center gap-2 rounded-full px-3 py-1 font-medium ' + (n === step ? 'bg-navy-800 text-white' : n < step ? 'text-teal-700' : 'text-slate-600');
      n === step ? li.setAttribute('aria-current', 'step') : li.removeAttribute('aria-current');
    });
    $('bk-back').hidden = step === 1;
    $('bk-next').hidden = step === TOTAL;
    $('bk-submit').hidden = step !== TOTAL;
    if (step === 4) {
      // jump to the month of the first available day
      if (!state.date) {
        const first = firstAvailableDate();
        if (first) state.month = new Date(Number(first.slice(0, 4)), Number(first.slice(5, 7)) - 1, 1);
      }
      renderCalendar(); renderSlots();
    }
    if (step === 5) $('bk-summary').textContent = summaryText();
    showError('');
    if (focus) form.querySelector<HTMLElement>(`[data-step="${step}"] h2`)?.focus();
  }

  const stepErrors: Record<number, () => string> = {
    1: () => (val('service') ? '' : B.errService),
    2: () => (val('format') ? '' : B.errFormat),
    3: () => (val('professional') ? '' : B.errPro),
    4: () => (state.date && state.time ? '' : B.errSlot),
  };

  $('bk-next').addEventListener('click', () => {
    const err = stepErrors[state.step]?.() ?? '';
    if (err) return showError(err);
    if (state.step === 3) { state.date = ''; state.time = ''; }
    go(state.step + 1);
  });
  $('bk-back').addEventListener('click', () => go(state.step - 1));
  form.addEventListener('change', (e) => {
    const name = (e.target as HTMLInputElement).name;
    if (name === 'professional' || name === 'format' || name === 'service') { state.date = ''; state.time = ''; }
  });
  $('cal-prev').addEventListener('click', () => { state.month = new Date(state.month.getFullYear(), state.month.getMonth() - 1, 1); renderCalendar(); });
  $('cal-next').addEventListener('click', () => { state.month = new Date(state.month.getFullYear(), state.month.getMonth() + 1, 1); renderCalendar(); });

  /** Plain-text summary used for the mailto body and the clipboard. */
  function requestText(payload: BookingPayload) {
    return [
      summaryText(),
      '',
      `${B.mailName}: ${payload.name}`,
      `${B.mailEmail}: ${payload.email}`,
      `${B.mailPhone}: ${payload.phone}`,
      payload.note ? `${B.mailNote}: ${payload.note}` : '',
    ].filter((line, i, all) => line || all[i - 1] !== '').join('\n');
  }

  const make = <K extends keyof HTMLElementTagNameMap>(tag: K, text = '', className = '') => {
    const node = document.createElement(tag);
    node.textContent = text;
    if (className) node.className = className;
    return node;
  };
  const makeLink = (href: string, text: string, className = '') => {
    const a = make('a', text, className);
    a.href = href;
    return a;
  };

  function showDone(payload: BookingPayload, sent: { ok: boolean; reason?: string }) {
    const body = $('done-body');
    body.replaceChildren();
    const text = requestText(payload);
    body.append(make('p', summaryText(), 'rounded-xl bg-sage-100 p-4 font-medium'));

    if (sent.ok) {
      body.append(make('p', `${B.thanks} ${payload.name}${B.received}`));
    } else {
      const message = sent.reason === 'no-endpoint' ? B.noEndpointText : sent.reason === 'timeout' ? B.timeoutText : B.failText;
      body.append(make('p', message));
      const actions = make('div', '', 'flex flex-wrap items-center gap-3');
      const mail = makeLink(mailtoHref(site.contact.email, B.mailSubject, text), B.sendByEmail, 'btn btn-primary');
      const copy = make('button', B.copySummary, 'btn btn-secondary');
      copy.type = 'button';
      const copied = make('span', '', 'text-sm');
      copied.setAttribute('role', 'status');
      copy.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(text); copied.textContent = B.copied; }
        catch { copied.textContent = ''; }
      });
      actions.append(mail, copy, copied);
      const contacts = make('ul', '', 'space-y-1');
      const add = (label: string, a: HTMLAnchorElement) => { const li = make('li', `${label}: `); li.append(a); contacts.append(li); };
      add(B.mailEmail, makeLink(`mailto:${site.contact.email}`, site.contact.email));
      add(B.pecLabel, makeLink(`mailto:${site.contact.pec}`, site.contact.pec));
      add(B.phoneLabel, makeLink(`tel:${site.contact.phoneRaw}`, site.contact.phone));
      body.append(actions, contacts);
    }

    const ics = make('button', B.downloadIcs, 'btn btn-secondary');
    ics.type = 'button';
    ics.addEventListener('click', () => downloadBookingIcs({
      date: payload.date,
      time: payload.time,
      durationMinutes: selectedService()?.minutes ?? agendaConfig.sessionMinutes,
      serviceLabel: selectedService()?.label ?? '',
      professionalName: names[payload.professional] ?? '',
      formatLabel: formatLabel(),
      location: sessionLocations[payload.format][T.locale],
      labels: { summary: B.icsSummary, pendingNotice: B.icsPending, service: B.icsService, professional: B.icsProfessional, format: B.icsFormat },
    }));
    body.append(ics, make('p', B.icsHint, 'text-sm text-slate-600'));
    form.hidden = true; $('booking-done').hidden = false; $('booking-done').focus();
  }

  const errId: Record<string, string> = { name: 'b-name', email: 'b-email', phone: 'b-phone', note: 'b-note', policy: 'b-policy', consent: 'b-consent' };
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const d = new FormData(form);
    const payload: BookingPayload = {
      service: val('service'), format: val('format') as BookingPayload['format'], professional: resolvedPro() as BookingPayload['professional'],
      date: state.date, time: state.time, name: String(d.get('name') || ''), email: String(d.get('email') || ''),
      phone: String(d.get('phone') || ''), note: String(d.get('note') || ''), consent: d.has('consent'), policy: d.has('policy'),
      website: String(d.get('website') || ''), locale: T.locale,
    };
    const errors = validateBooking(payload, T.validation);
    form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => { el.hidden = true; });
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const keys = Object.keys(errors) as (keyof typeof errors)[];
    if (keys.length) {
      for (const k of keys) {
        const el = document.getElementById(`${errId[k]}-err`);
        if (el) { el.textContent = errors[k]!; el.hidden = false; }
        form.querySelector(`[name="${k}"]`)?.setAttribute('aria-invalid', 'true');
      }
      showError(B.errFields);
      form.querySelector<HTMLElement>(`[name="${keys[0]}"]`)?.focus();
      return;
    }
    if (payload.website) return; // honeypot filled: bot
    const btn = $('bk-submit') as HTMLButtonElement;
    btn.disabled = true; btn.textContent = B.sending;
    const { website: _honeypot, ...data } = payload;
    const result = await submitToEndpoint(site.endpoints.booking, { ...data, summary: summaryText() });
    btn.disabled = false; btn.textContent = B.submit;
    showDone(payload, result);
  });

  $('bk-restart').addEventListener('click', () => {
    form.reset(); state.date = ''; state.time = ''; form.hidden = false; $('booking-done').hidden = true; go(1);
  });

  // Presets from the URL (service and professional ids only: never personal data).
  const params = new URLSearchParams(location.search);
  const preset = params.get('servizio') || root.dataset.preset;
  if (preset && services.some((s) => s.id === preset)) {
    (form.querySelector(`input[name=service][value="${preset}"]`) as HTMLInputElement | null)?.click();
  }
  const presetPro = params.get('professional');
  if (presetPro && names[presetPro]) {
    (form.querySelector(`input[name=professional][value="${presetPro}"]`) as HTMLInputElement | null)?.click();
  }
  go(1, false);

  // Optional runtime merge of occupied slots; the static agenda is used when the feed is missing or fails.
  fetchAgendaFeed(site.endpoints.agendaFeed).then((slots) => {
    feed = slots;
    if (state.step === 4) { renderCalendar(); renderSlots(); }
  });
</script>
