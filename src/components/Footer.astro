---
import { site, getProfessionals, nav } from '../config/site';
import { i18n } from '../i18n';
const { locale, t, l } = i18n(Astro);
const professionals = getProfessionals(locale);
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-navy-900 text-sage-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-serif text-2xl text-white">{site.name}</p>
      <p class="mt-3 text-sage-200">{t.meta.tagline}.</p>
      <address class="mt-4 not-italic text-sage-200">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city} ({site.address.province})<br />
        <a class="text-white" href={site.address.mapsUrl} rel="noopener noreferrer" target="_blank">{t.footer.mapsLink}<span class="sr-only text-decoration-none">{t.common.newTab}</span></a>
      </address>
    </div>
    <div>
      <h2 class="!font-sans !text-base font-semibold uppercase tracking-widest !text-white">{t.footer.contacts}</h2>
      <ul class="mt-4 space-y-2 text-sage-200">
        <li>{professionals.provini.name}: <a class="text-white" href={`tel:${professionals.provini.phoneRaw}`}>{professionals.provini.phone}</a></li>
        <li>{professionals.coccia.name}: <a class="text-white" href={`tel:${professionals.coccia.phoneRaw}`}>{professionals.coccia.phone}</a></li>
        <li>{t.common.email}: <a class="text-white" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li>PEC: <a class="text-white" href={`mailto:${site.contact.pec}`}>{site.contact.pec}</a></li>
        <li>{t.common.whatsappTelegram}: <a class="text-white" href={`https://wa.me/${site.contact.phoneRaw.replace('+', '')}`} rel="noopener noreferrer" target="_blank">{site.contact.phone}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="!font-sans !text-base font-semibold uppercase tracking-widest !text-white">{t.footer.explore}</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2">
        {nav.map((n) => <li><a class="text-sage-200 hover:text-white" href={l(n.href)}>{t.nav[n.key]}</a></li>)}
        <li><a class="text-sage-200 hover:text-white" href={l('/prenota')}>{t.common.book}</a></li>
        <li><a class="text-sage-200 hover:text-white" href={l('/interviste')}>{t.nav.interviews}</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-page space-y-3 py-6 text-sm text-sage-200">
      <p>
        <strong class="text-white">{t.footer.emergencyLabel}</strong> {t.footer.emergencyBefore} <a class="text-white" href="tel:112">112</a>.
      </p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <span>© {year} {site.name}. {t.footer.credits}</span>
        <a class="text-white" href={l('/privacy')}>{t.footer.privacy}</a>
        <a class="text-white" href={l('/cookie')}>{t.footer.cookies}</a>
        <a class="text-white" href={l('/note-legali')}>{t.footer.legal}</a>
        <button type="button" class="underline text-white" data-open-cookie-settings>{t.footer.cookiePrefs}</button>
      </p>
    </div>
  </div>
</footer>
