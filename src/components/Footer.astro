---
import { site, professionals, nav } from '../config/site';
const year = new Date().getFullYear();
---

<footer class="mt-16 bg-navy-900 text-sage-100">
  <div class="container-page grid gap-10 py-14 md:grid-cols-3">
    <div>
      <p class="font-serif text-2xl text-white">{site.name}</p>
      <p class="mt-3 text-sage-200">{site.tagline}.</p>
      <address class="mt-4 not-italic text-sage-200">
        {site.address.street}<br />
        {site.address.postalCode} {site.address.city} ({site.address.province})<br />
        <a class="text-white" href={site.address.mapsUrl} rel="noopener noreferrer" target="_blank">Apri su Google Maps<span class="sr-only"> (si apre in una nuova scheda)</span></a>
      </address>
    </div>
    <div>
      <h2 class="!font-sans !text-base font-semibold uppercase tracking-widest !text-white">Contatti</h2>
      <ul class="mt-4 space-y-2 text-sage-200">
        <li>{professionals.provini.name}: <a class="text-white" href={`tel:${professionals.provini.phoneRaw}`}>{professionals.provini.phone}</a></li>
        <li>{professionals.coccia.name}: <a class="text-white" href={`tel:${professionals.coccia.phoneRaw}`}>{professionals.coccia.phone}</a></li>
        <li>Email: <a class="text-white" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
        <li>PEC: <a class="text-white" href={`mailto:${site.contact.pec}`}>{site.contact.pec}</a></li>
        <li>WhatsApp / Telegram: <a class="text-white" href={`https://wa.me/${site.contact.phoneRaw.replace('+', '')}`} rel="noopener noreferrer" target="_blank">{site.contact.phone}</a></li>
      </ul>
    </div>
    <div>
      <h2 class="!font-sans !text-base font-semibold uppercase tracking-widest !text-white">Esplora</h2>
      <ul class="mt-4 grid grid-cols-2 gap-2">
        {nav.map((n) => <li><a class="text-sage-200 hover:text-white" href={n.href}>{n.label}</a></li>)}
        <li><a class="text-sage-200 hover:text-white" href="/prenota">Prenota</a></li>
        <li><a class="text-sage-200 hover:text-white" href="/interviste">Interviste</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/15">
    <div class="container-page space-y-3 py-6 text-sm text-sage-200">
      <p>
        <strong class="text-white">Emergenze:</strong> questo sito non è un servizio di emergenza. In caso di pericolo
        immediato chiama il <a class="text-white" href="tel:112">112</a>.
      </p>
      <p class="flex flex-wrap gap-x-5 gap-y-1">
        <span>© {year} {site.name}. Dott. Mirko Provini — Psicologo Clinico, OPL n. 24451.</span>
        <a class="text-white" href="/privacy">Privacy Policy</a>
        <a class="text-white" href="/cookie">Cookie Policy</a>
        <a class="text-white" href="/note-legali">Note legali</a>
        <button type="button" class="underline text-white" data-open-cookie-settings>Preferenze cookie</button>
      </p>
    </div>
  </div>
</footer>
