---
import { i18n } from '../i18n';
const { t } = i18n(Astro);
---

<aside role="note" aria-label={t.emergency.label} class="rounded-2xl border-l-8 border-alert bg-alert-bg p-5 text-alert">
  <p class="font-semibold">{t.emergency.title}</p>
  <p class="mt-1 text-ink">{t.emergency.text} <a class="font-semibold text-alert" href="tel:112">{t.common.callEmergency}</a>.</p>
</aside>
