---
// Granular cookie consent. The site sets no analytics or marketing cookies by default;
// the categories exist so that any future tool is loaded ONLY after explicit opt-in
// (listen for the `psycoped:consent` event on `window`).
import { i18n } from '../i18n';
const { t, l } = i18n(Astro);
const c = t.cookieBanner;
---

<div id="cookie-banner" role="region" aria-label={c.region} hidden
  class="fixed inset-x-0 bottom-0 z-50 border-t border-line bg-white p-5 shadow-2xl">
  <div class="container-page flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="max-w-3xl text-base">
      {c.text} <a href={l('/cookie')}>{c.policyLink}</a>.
    </p>
    <div class="flex flex-wrap gap-3">
      <button type="button" class="btn btn-secondary" data-consent="reject">{c.reject}</button>
      <button type="button" class="btn btn-secondary" data-open-cookie-settings>{c.customize}</button>
      <button type="button" class="btn btn-primary" data-consent="all">{c.acceptAll}</button>
    </div>
  </div>
</div>

<dialog id="cookie-dialog" aria-labelledby="cookie-dialog-title" class="m-auto w-[min(92vw,34rem)] rounded-2xl p-0 backdrop:bg-slate-900/50">
  <form method="dialog" id="cookie-form" class="space-y-5 p-6">
    <h2 id="cookie-dialog-title" class="!text-2xl">{c.dialogTitle}</h2>
    <fieldset class="space-y-4">
      <legend class="sr-only">{c.categories}</legend>
      <label class="flex items-start gap-3">
        <input type="checkbox" checked disabled class="mt-1.5 h-5 w-5" />
        <span><strong>{c.necessary}</strong><br /><span class="hint">{c.necessaryHint}</span></span>
      </label>
      <label class="flex items-start gap-3">
        <input type="checkbox" name="analytics" class="mt-1.5 h-5 w-5" />
        <span><strong>{c.analytics}</strong><br /><span class="hint">{c.analyticsHint}</span></span>
      </label>
      <label class="flex items-start gap-3">
        <input type="checkbox" name="media" class="mt-1.5 h-5 w-5" />
        <span><strong>{c.media}</strong><br /><span class="hint">{c.mediaHint}</span></span>
      </label>
    </fieldset>
    <div class="flex flex-wrap justify-end gap-3">
      <button type="button" class="btn btn-secondary" id="cookie-cancel">{c.cancel}</button>
      <button type="submit" class="btn btn-primary">{c.save}</button>
    </div>
  </form>
</dialog>

<script>
  const KEY = 'psycoped-consent';
  type Consent = { analytics: boolean; media: boolean; ts: number };

  const banner = document.getElementById('cookie-banner') as HTMLElement;
  const dialog = document.getElementById('cookie-dialog') as HTMLDialogElement;
  const form = document.getElementById('cookie-form') as HTMLFormElement;

  const read = (): Consent | null => {
    try { return JSON.parse(localStorage.getItem(KEY) || 'null'); } catch { return null; }
  };
  const save = (c: Omit<Consent, 'ts'>) => {
    const value: Consent = { ...c, ts: Date.now() };
    localStorage.setItem(KEY, JSON.stringify(value));
    banner.hidden = true;
    window.dispatchEvent(new CustomEvent('psycoped:consent', { detail: value }));
  };

  const current = read();
  if (!current) banner.hidden = false;
  else window.dispatchEvent(new CustomEvent('psycoped:consent', { detail: current }));

  const openSettings = () => {
    const c = read();
    (form.elements.namedItem('analytics') as HTMLInputElement).checked = !!c?.analytics;
    (form.elements.namedItem('media') as HTMLInputElement).checked = !!c?.media;
    dialog.showModal();
  };

  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (t.closest('[data-open-cookie-settings]')) openSettings();
    const choice = t.closest<HTMLElement>('[data-consent]')?.dataset.consent;
    if (choice === 'all') save({ analytics: true, media: true });
    if (choice === 'reject') save({ analytics: false, media: false });
  });
  document.getElementById('cookie-cancel')?.addEventListener('click', () => dialog.close());
  form.addEventListener('submit', () => {
    const data = new FormData(form);
    save({ analytics: data.has('analytics'), media: data.has('media') });
  });
</script>
