---
import type { FaqItem } from '../data/faq';
interface Props { items: FaqItem[] }
const { items } = Astro.props;
---

<div class="divide-y divide-line rounded-2xl border border-line bg-white">
  {items.map((f) => (
    <details class="group p-5">
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 font-serif text-lg font-semibold text-navy-900">
        {f.q}
        <span aria-hidden="true" class="text-2xl text-teal-700 transition group-open:rotate-45">+</span>
      </summary>
      <p class="mt-3 max-w-3xl text-slate-700">{f.a}</p>
    </details>
  ))}
</div>
