---
import { site } from '../config/site';
import { getServices } from '../data/services';
import { i18n } from '../i18n';

interface Props { presetSubject?: string }
const { presetSubject = '' } = Astro.props;
const { locale, t, l } = i18n(Astro);
const f = t.contactForm;
const subjects = [...getServices(locale).map((s) => s.title), f.subjectGeneral];
const channels = Object.entries(f.channels) as [string, string][];
// Strings needed by the client-side script.
const clientT = { locale, validation: t.validation, form: f };
---

<form id="contact-form" novalidate class="space-y-5" data-endpoint={site.endpoints.contact}
  data-email={site.contact.email} data-t={JSON.stringify(clientT)}>
  <div id="contact-summary" role="alert" tabindex="-1" hidden class="rounded-xl border-2 border-alert bg-alert-bg p-4 text-alert"></div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="field">
      <label for="c-name">{f.name} <span aria-hidden="true">*</span></label>
      <input id="c-name" name="name" class="input" autocomplete="name" required aria-describedby="c-name-err" />
      <p id="c-name-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-email">{f.email} <span aria-hidden="true">*</span></label>
      <input id="c-email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="c-email-err" />
      <p id="c-email-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-phone">{f.phone}</label>
      <input id="c-phone" name="phone" type="tel" class="input" autocomplete="tel" aria-describedby="c-phone-hint c-phone-err" />
      <p id="c-phone-hint" class="hint">{f.phoneHint}</p>
      <p id="c-phone-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-window">{f.window}</label>
      <select id="c-window" name="callbackWindow" class="input">
        <option value="">{f.windowNone}</option>
        <option>{f.windowMorning}</option>
        <option>{f.windowAfternoon}</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="c-subject">{f.subject} <span aria-hidden="true">*</span></label>
    <select id="c-subject" name="subject" class="input" required aria-describedby="c-subject-err">
      <option value="">{f.subjectPlaceholder}</option>
      {subjects.map((s) => <option selected={s === presetSubject}>{s}</option>)}
    </select>
    <p id="c-subject-err" class="field-error" hidden></p>
  </div>

  <fieldset aria-describedby="c-channel-err">
    <legend class="label">{f.channelLegend} <span aria-hidden="true">*</span></legend>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      {channels.map(([v, label], i) => (
        <label class="flex min-h-11 items-center gap-2"><input type="radio" name="channel" value={v} class="h-5 w-5" checked={i === 1} /> {label}</label>
      ))}
    </div>
    <p id="c-channel-err" class="field-error" hidden></p>
  </fieldset>

  <div class="field">
    <label for="c-message">{f.message} <span aria-hidden="true">*</span></label>
    <textarea id="c-message" name="message" rows="5" maxlength="2000" class="input" required aria-describedby="c-message-hint c-message-err"></textarea>
    <p id="c-message-hint" class="hint">{f.messageHint}</p>
    <p id="c-message-err" class="field-error" hidden></p>
  </div>

  <!-- Honeypot: hidden from people and assistive tech -->
  <div aria-hidden="true" style="position:absolute;left:-9999px"><label>{f.honeypot} <input name="website" tabindex="-1" autocomplete="off" /></label></div>

  <div class="field">
    <label class="flex items-start gap-3 !font-normal">
      <input type="checkbox" name="consent" class="mt-1.5 h-5 w-5" required aria-describedby="c-consent-err" />
      <span>{f.consentBefore}<a href={l('/privacy')} target="_blank">{f.consentLink}</a> {f.consentAfter} <span aria-hidden="true">*</span></span>
    </label>
    <p id="c-consent-err" class="field-error" hidden></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary">{f.submit}</button>
    <p class="hint !mt-0">{t.common.required}</p>
  </div>

  <div id="contact-status" role="status" aria-live="polite" tabindex="-1" hidden class="rounded-xl border border-teal-600 bg-sage-100 p-4"></div>
</form>

<script>
  import { validateContact, type ContactPayload } from '../lib/validation';
  import { submitToEndpoint, mailtoHref, type SubmitResult } from '../lib/submit';
  import { site } from '../config/site';
  import type { Dict } from '../i18n/it';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const summary = document.getElementById('contact-summary') as HTMLElement;
  const status = document.getElementById('contact-status') as HTMLElement;
  const T: { locale: string; validation: Dict['validation']; form: Dict['contactForm'] } = JSON.parse(form.dataset.t!);
  const idFor: Record<string, string> = { name: 'c-name', email: 'c-email', phone: 'c-phone', subject: 'c-subject', message: 'c-message', consent: 'c-consent', channel: 'c-channel' };

  /** Escape text before it is placed in an innerHTML template. */
  const esc = (s: string) => s.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  const read = (): ContactPayload => {
    const d = new FormData(form);
    return {
      name: String(d.get('name') || ''), email: String(d.get('email') || ''), phone: String(d.get('phone') || ''),
      callbackWindow: String(d.get('callbackWindow') || ''), subject: String(d.get('subject') || ''),
      channel: String(d.get('channel') || '') as ContactPayload['channel'], message: String(d.get('message') || ''),
      consent: d.get('consent') === 'on', website: String(d.get('website') || ''), locale: T.locale,
    };
  };

  function showErrors(errors: Record<string, string | undefined>) {
    form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => { el.hidden = true; el.textContent = ''; });
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const keys = Object.keys(errors).filter((k) => errors[k]);
    if (!keys.length) { summary.hidden = true; return false; }
    for (const k of keys) {
      const err = document.getElementById(`${idFor[k]}-err`);
      if (err) { err.textContent = errors[k]!; err.hidden = false; }
      form.querySelector(`[name="${k}"]`)?.setAttribute('aria-invalid', 'true');
    }
    summary.innerHTML = `<p class="font-semibold">${esc(T.form.fixFields)}</p><ul class="mt-1 list-disc pl-5">${keys
      .map((k) => `<li><a class="text-alert" href="#${idFor[k] === 'c-consent' || idFor[k] === 'c-channel' ? idFor[k] + '-err' : idFor[k]}">${esc(errors[k]!)}</a></li>`).join('')}</ul>`;
    summary.hidden = false;
    summary.focus();
    return true;
  }

  const summaryText = (p: ContactPayload) =>
    [
      `${T.form.mailService}: ${p.subject}`,
      `${T.form.mailName}: ${p.name}`,
      `Email: ${p.email}`,
      p.phone ? `${T.form.mailPhone}: ${p.phone}` : '',
      `${T.form.mailChannel}: ${T.form.channels[p.channel]}`,
      '',
      `${T.form.mailMessage}: ${p.message}`,
    ].filter((line, index, all) => line || all[index - 1] !== '').join('\n');

  /** Fallback card: shown when no endpoint is configured or the network submission fails. */
  function renderFallback(payload: ContactPayload, result: SubmitResult) {
    const summary = summaryText(payload);
    const title = result.reason === 'no-endpoint' ? T.form.noEndpointTitle : result.reason === 'timeout' ? T.form.timeoutTitle : T.form.failTitle;
    const intro = result.reason === 'no-endpoint' ? T.form.noEndpointText : T.form.failBefore;
    status.replaceChildren();
    const make = <K extends keyof HTMLElementTagNameMap>(tag: K, text = '', className = '') => {
      const el = document.createElement(tag);
      el.textContent = text;
      if (className) el.className = className;
      return el;
    };
    const link = (href: string, text: string) => {
      const a = make('a', text);
      a.href = href;
      return a;
    };
    const pre = make('pre', summary, 'mt-3 max-h-48 overflow-auto whitespace-pre-wrap rounded-lg bg-white p-3 text-sm');
    const copy = make('button', T.form.copySummary, 'btn btn-secondary');
    copy.type = 'button';
    const copied = make('span', '', 'ml-3 text-sm');
    copied.setAttribute('role', 'status');
    copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(summary);
        copied.textContent = T.form.copied;
      } catch {
        const range = document.createRange();
        range.selectNodeContents(pre);
        getSelection()?.removeAllRanges();
        getSelection()?.addRange(range);
      }
    });
    const mail = link(mailtoHref(site.contact.email, `${T.form.mailSubject} ${payload.subject}`, summary), T.form.sendByEmail);
    mail.className = 'btn btn-primary';
    const contacts = make('ul', '', 'mt-4 space-y-1');
    const li = (label: string, a: HTMLAnchorElement) => {
      const item = make('li', `${label}: `);
      item.append(a);
      contacts.append(item);
    };
    li('Email', link(`mailto:${site.contact.email}`, site.contact.email));
    li(T.form.pecLabel, link(`mailto:${site.contact.pec}`, site.contact.pec));
    li(T.form.mailPhone, link(`tel:${site.contact.phoneRaw}`, site.contact.phone));
    li(T.form.messagingLabel, link(`https://wa.me/${site.contact.phoneRaw.replace('+', '')}`, site.contact.phone));
    const actions = make('div', '', 'mt-4 flex flex-wrap items-center');
    actions.append(mail, copy, copied);
    status.append(make('p', title, 'font-semibold'), make('p', intro), make('p', T.form.summaryTitle, 'mt-3 font-semibold'), pre, actions, contacts);
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.hidden = true;
    const payload = read();
    if (showErrors(validateContact(payload, T.validation))) return;
    if (payload.website) return; // honeypot filled: bot
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true; btn.textContent = T.form.sending;
    const { website: _honeypot, ...data } = payload;
    const result = await submitToEndpoint(form.dataset.endpoint ?? '', data);
    btn.disabled = false; btn.textContent = T.form.submit;
    status.hidden = false;
    if (result.ok) {
      status.replaceChildren();
      const title = document.createElement('p');
      title.className = 'font-semibold';
      title.textContent = T.form.okTitle;
      const text = document.createElement('p');
      text.textContent = T.form.okText;
      status.append(title, text);
      form.reset();
    } else {
      renderFallback(payload, result);
    }
    status.focus();
  });
</script>
