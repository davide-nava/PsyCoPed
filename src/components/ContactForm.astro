---
import { site } from '../config/site';
import { services } from '../data/services';

interface Props { presetSubject?: string }
const { presetSubject = '' } = Astro.props;
const subjects = [...services.map((s) => s.title), 'Informazioni generali'];
---

<form id="contact-form" novalidate class="space-y-5" data-endpoint={site.endpoints.contact}
  data-email={site.contact.email}>
  <div id="contact-summary" role="alert" tabindex="-1" hidden class="rounded-xl border-2 border-alert bg-alert-bg p-4 text-alert"></div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div class="field">
      <label for="c-name">Nome e cognome <span aria-hidden="true">*</span></label>
      <input id="c-name" name="name" class="input" autocomplete="name" required aria-describedby="c-name-err" />
      <p id="c-name-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-email">Email <span aria-hidden="true">*</span></label>
      <input id="c-email" name="email" type="email" class="input" autocomplete="email" required aria-describedby="c-email-err" />
      <p id="c-email-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-phone">Telefono</label>
      <input id="c-phone" name="phone" type="tel" class="input" autocomplete="tel" aria-describedby="c-phone-hint c-phone-err" />
      <p id="c-phone-hint" class="hint">Obbligatorio se scegli telefono, WhatsApp o Telegram.</p>
      <p id="c-phone-err" class="field-error" hidden></p>
    </div>
    <div class="field">
      <label for="c-window">Fascia oraria preferita per essere richiamato</label>
      <select id="c-window" name="callbackWindow" class="input">
        <option value="">Nessuna preferenza</option>
        <option>Mattina (9–13)</option>
        <option>Pomeriggio (14–19)</option>
      </select>
    </div>
  </div>

  <div class="field">
    <label for="c-subject">Servizio di interesse <span aria-hidden="true">*</span></label>
    <select id="c-subject" name="subject" class="input" required aria-describedby="c-subject-err">
      <option value="">Seleziona…</option>
      {subjects.map((s) => <option selected={s === presetSubject}>{s}</option>)}
    </select>
    <p id="c-subject-err" class="field-error" hidden></p>
  </div>

  <fieldset aria-describedby="c-channel-err">
    <legend class="label">Come preferisci essere contattato/a? <span aria-hidden="true">*</span></legend>
    <div class="flex flex-wrap gap-x-6 gap-y-2">
      {[['phone', 'Telefono'], ['email', 'Email'], ['whatsapp', 'WhatsApp'], ['telegram', 'Telegram']].map(([v, l], i) => (
        <label class="flex min-h-11 items-center gap-2"><input type="radio" name="channel" value={v} class="h-5 w-5" checked={i === 1} /> {l}</label>
      ))}
    </div>
    <p id="c-channel-err" class="field-error" hidden></p>
  </fieldset>

  <div class="field">
    <label for="c-message">Messaggio <span aria-hidden="true">*</span></label>
    <textarea id="c-message" name="message" rows="5" maxlength="2000" class="input" required aria-describedby="c-message-hint c-message-err"></textarea>
    <p id="c-message-hint" class="hint">Descrivi brevemente la tua richiesta. Evita di inserire dati sanitari dettagliati: ne parleremo in colloquio.</p>
    <p id="c-message-err" class="field-error" hidden></p>
  </div>

  <!-- Honeypot: hidden from people and assistive tech -->
  <div aria-hidden="true" style="position:absolute;left:-9999px"><label>Sito web <input name="website" tabindex="-1" autocomplete="off" /></label></div>

  <div class="field">
    <label class="flex items-start gap-3 !font-normal">
      <input type="checkbox" name="consent" class="mt-1.5 h-5 w-5" required aria-describedby="c-consent-err" />
      <span>Ho letto l’<a href="/privacy" target="_blank">Informativa Privacy</a> e acconsento al trattamento dei miei dati per rispondere alla richiesta. <span aria-hidden="true">*</span></span>
    </label>
    <p id="c-consent-err" class="field-error" hidden></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button type="submit" class="btn btn-primary">Invia richiesta</button>
    <p class="hint !mt-0">* campi obbligatori</p>
  </div>

  <div id="contact-status" role="status" aria-live="polite" tabindex="-1" hidden class="rounded-xl border border-teal-600 bg-sage-100 p-4"></div>
</form>

<script>
  import { validateContact, type ContactPayload } from '../lib/validation';
  import { postJson, mailtoHref } from '../lib/submit';
  import { site } from '../config/site';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const summary = document.getElementById('contact-summary') as HTMLElement;
  const status = document.getElementById('contact-status') as HTMLElement;
  const idFor: Record<string, string> = { name: 'c-name', email: 'c-email', phone: 'c-phone', subject: 'c-subject', message: 'c-message', consent: 'c-consent', channel: 'c-channel' };

  const read = (): ContactPayload => {
    const d = new FormData(form);
    return {
      name: String(d.get('name') || ''), email: String(d.get('email') || ''), phone: String(d.get('phone') || ''),
      callbackWindow: String(d.get('callbackWindow') || ''), subject: String(d.get('subject') || ''),
      channel: String(d.get('channel') || '') as ContactPayload['channel'], message: String(d.get('message') || ''),
      consent: d.get('consent') === 'on', website: String(d.get('website') || ''),
    };
  };

  function showErrors(errors: Record<string, string | undefined>) {
    form.querySelectorAll<HTMLElement>('.field-error').forEach((el) => { el.hidden = true; el.textContent = ''; });
    form.querySelectorAll('[aria-invalid]').forEach((el) => el.removeAttribute('aria-invalid'));
    const keys = Object.keys(errors).filter((k) => errors[k]);
    if (!keys.length) { summary.hidden = true; return false; }
    for (const k of keys) {
      const err = document.getElementById(`${idFor[k]}-err`);
      if (err) { err.textContent = errors[k]!; err.hidden = false; }
      form.querySelector(`[name="${k}"]`)?.setAttribute('aria-invalid', 'true');
    }
    summary.innerHTML = `<p class="font-semibold">Controlla i campi evidenziati:</p><ul class="mt-1 list-disc pl-5">${keys
      .map((k) => `<li><a class="text-alert" href="#${idFor[k] === 'c-consent' || idFor[k] === 'c-channel' ? idFor[k] + '-err' : idFor[k]}">${errors[k]}</a></li>`).join('')}</ul>`;
    summary.hidden = false;
    summary.focus();
    return true;
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    status.hidden = true;
    const payload = read();
    if (showErrors(validateContact(payload))) return;
    if (payload.website) return; // bot
    const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
    btn.disabled = true; btn.textContent = 'Invio in corso…';
    const res = await postJson(form.dataset.endpoint!, payload);
    btn.disabled = false; btn.textContent = 'Invia richiesta';
    status.hidden = false;
    if (res.ok) {
      status.innerHTML = '<p class="font-semibold">Grazie, richiesta inviata.</p><p>Ti risponderemo appena possibile. Questo modulo non è monitorato in tempo reale: in caso di emergenza chiama il 112.</p>';
      form.reset();
    } else {
      const body = `Nome: ${payload.name}\nTelefono: ${payload.phone}\nCanale preferito: ${payload.channel}\n\n${payload.message}`;
      status.innerHTML = `<p class="font-semibold">Non è stato possibile inviare la richiesta online.</p>
        <p>Puoi contattarci direttamente: <a href="${mailtoHref(site.contact.email, 'Richiesta informazioni: ' + payload.subject, body)}">invia email</a>,
        scrivi alla PEC <a href="mailto:${site.contact.pec}">${site.contact.pec}</a> oppure chiama <a href="tel:${site.contact.phoneRaw}">${site.contact.phone}</a>.</p>`;
    }
    status.focus();
  });
</script>
